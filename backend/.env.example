# =============================================================================
# N3XT 3D System — Configuración de Entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------
APP_NAME=N3XT
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Generar con: php artisan key:generate
APP_KEY=

# Opcional: claves anteriores para rotación segura (separadas por coma)
APP_PREVIOUS_KEYS=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

MAINTENANCE_DRIVER=file
MAINTENANCE_STORE=database

# -----------------------------------------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=n3xt3d
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# AUTENTICACIÓN & SANCTUM
# -----------------------------------------------------------------------------
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

# Dominios que usan cookies de sesión (SPA)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# Duración de tokens API en minutos (43200 = 30 días)
SANCTUM_TOKEN_EXPIRATION=43200

# Prefijo de tokens para GitHub secret scanning
SANCTUM_TOKEN_PREFIX=n3xt_

# -----------------------------------------------------------------------------
# CORS — Orígenes permitidos (separados por coma)
# -----------------------------------------------------------------------------
# Producción: CORS_ALLOWED_ORIGINS=https://n3xt3d.com,https://admin.n3xt3d.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# SESIÓN
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_SAME_SITE=null
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_TABLE=sessions
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=single
LOG_DAILY_DAYS=14

# Slack (opcional)
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=N3XT
LOG_SLACK_EMOJI=:robot:

# Papertrail (opcional)
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# -----------------------------------------------------------------------------
# CACHE
# -----------------------------------------------------------------------------
CACHE_STORE=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks

# Redis (opcional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Memcached (opcional)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# -----------------------------------------------------------------------------
# COLAS (QUEUE)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# CORREO
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@n3xt3d.com
MAIL_FROM_NAME="${APP_NAME}"

# Postmark (opcional)
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=

# Resend (opcional)
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# ALMACENAMIENTO / ARCHIVOS
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# S3 / Spaces (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# SERVICIOS EXTERNOS
# -----------------------------------------------------------------------------

# Cloudflare Turnstile (CAPTCHA invisible)
TURNSTILE_SECRET=

# Slack Bot (opcional — notificaciones)
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# -----------------------------------------------------------------------------
# VERCEL (SOLO PRODUCCIÓN — no modificar manualmente)
# -----------------------------------------------------------------------------
# Estas variables son inyectadas automáticamente por Vercel.
# VERCEL=true
# Broadcast (opcional - para WebSockets)
BROADCAST_CONNECTION=log

LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# VERCEL_URL=my-app.vercel.app
# LAMBDA_TASK_ROOT=/var/task
