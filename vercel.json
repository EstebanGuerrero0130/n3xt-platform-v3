{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/backend/public/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
