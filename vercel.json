{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "excludeFiles": "{frontend/**,node_modules/**,dist_exe/**,.git/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/backend/public/storage/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
