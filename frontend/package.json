{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:optimize": "node ./scripts/optimize-images.mjs",
    "build:full": "vite build && node ./scripts/optimize-images.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "@vercel/speed-insights": "^2.0.0",
    "@vue/tsconfig": "^0.9.1",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "html5-qrcode": "^2.3.8",
    "qrcode.vue": "^3.9.0",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^13.10.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.10",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^1.6.1"
  }
}
