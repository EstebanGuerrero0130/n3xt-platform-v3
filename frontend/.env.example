# =============================================================================
# N3XT 3D System — Frontend (Variables de Entorno Vite)
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Las variables deben comenzar con VITE_ para ser expuestas al frontend.
# =============================================================================

# URL Base de la API Laravel (backend)
VITE_API_URL=http://localhost:8000/api

# URL Base de Storage (archivos/imágenes)
VITE_STORAGE_URL=http://localhost:8000/storage

# Cloudflare Turnstile (anti-bot del Cotizador)
# Producción: site key real desde dash.cloudflare.com → Turnstile.
# Desarrollo: clave de prueba de Cloudflare que siempre pasa.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Analítica de visitas (opcional; deja ambas vacías para no medir).
# Plausible no usa cookies (recomendado). Con GA4 el aviso de privacidad ya
# menciona la medición; revisa si necesitas banner de cookies.
VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
# (Si usas un Plausible propio, agrega su dominio a script-src en frontend/index.html)
VITE_GA_ID=
